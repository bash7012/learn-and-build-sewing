---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogCard from '../components/CatalogCard.astro';
import { SITE_TITLE, buildNav } from '../lib/nav';

const foundations = await getCollection('foundations');
const items = await getCollection('items');
const nav = buildNav(foundations, items);

const foundationCopy: Record<string, string> = {
  'taking-measurements':
    'A way to get numbers you can trust before any later page.',
  'building-a-bodice-block':
    'A children\'s bodice block from measurements, not from a store-bought pattern.',
  'using-the-block':
    'How to use a fitted block against a pattern, or against clothes that already fit.',
};

const itemCopy: Record<string, string> = {
  'baby-onesie':
    'The first full garment: two ways to get a pattern, then one shared path to sew it.',
};

function firstImage(
  collection: typeof foundations | typeof items,
  id: string,
) {
  return collection.find((entry) => entry.id === id)?.data.images[0];
}

const foundationFallbacks: Record<string, { src: string; alt: string }> = {
  'taking-measurements': {
    src: '/images/stock/sewing-table.jpg',
    alt: 'Placeholder: a sewing machine beside folded fabric on a work table',
  },
  'building-a-bodice-block': {
    src: '/images/stock/sewing-machine-action.jpg',
    alt: 'Placeholder: hands guiding patterned fabric through a sewing machine',
  },
  'using-the-block': {
    src: '/images/stock/sewing-orange-fabric.jpg',
    alt: 'Placeholder: orange fabric under a sewing-machine presser foot',
  },
};

const start = nav.foundations[0];
const firstItem = nav.items[0];
---

<BaseLayout title={SITE_TITLE} variant="landing">
  <section class="hero">
    <img
      class="hero-image"
      src="/images/stock/sewing-table.jpg"
      alt="A sewing machine beside folded fabric, thread, and flowers on a work table"
      width="1600"
      height="1067"
    />
    <div class="hero-panel">
      <p class="hero-kicker">A practical guide</p>
      <h1 class="hero-title">{SITE_TITLE}</h1>
      <p class="hero-lead">
        How to draft, grade, and sew kids' clothes — starting at baby sizes and
        building toward a full wardrobe.
      </p>
      <p class="hero-actions">
        {start && (
          <a class="button" href={start.href}>Start with measurements</a>
        )}
        {firstItem?.href && (
          <a class="button button-quiet" href={firstItem.href}>
            Follow the {firstItem.title.toLowerCase()}
          </a>
        )}
      </p>
    </div>
  </section>

  <section class="statement" aria-labelledby="statement-heading">
    <h2 class="statement-title" id="statement-heading">
      A sewing guide
    </h2>
    <p class="statement-text">
      I'm going on a journey, and I'd like to take you along with me. I'll
      document how it goes as I learn — and teach — how to sew a full wardrobe
      for my kids — enough items to make up a closet, one garment at a time,
      plus the skills to draft from scratch, build more designs off the basics,
      and design your own. I've decided to tackle it all — all the things I
      didn't realise were separate skills: drafting blocks and pattern making,
      fitting and altering, and sewing and designing.
    </p>
  </section>

  <section class="references" aria-labelledby="references-heading">
    <h2 class="section-title" id="references-heading">Base references</h2>
    <p class="reference-intro">
      Two books sit under everything here. I take measurement points, children's
      blocks, and grading from Aldrich, and construction order, finishing, and
      bindings from the Reader's Digest guide. Nothing on this site reproduces
      their instructions: I work through a method, write it up in my own words,
      then record how it held up on a real garment and what I had to change for
      my own children. Both links go to the publishers' own pages.
    </p>
    <ul class="reference-list">
      <li class="reference">
        <a
          class="reference-link"
          href="https://www.wiley.com/en-us/Metric+Pattern+Cutting+for+Children%27s+Wear+and+Babywear%2C+4th+Edition-p-9781405182928"
        >
          Winifred Aldrich, Metric Pattern Cutting for Children's Wear and
          Babywear
          <svg
            class="reference-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M3.5 5.5c3-1 5.8-.5 8.5 1.5v12c-2.7-2-5.5-2.5-8.5-1.5z" />
            <path d="M12 7c2-1.5 4-2.1 6.2-1.8M12 19c2-1.5 4-2.1 6.2-1.8" />
            <path d="M16.5 8.5h4v4M20.5 8.5l-5 5" />
          </svg>
        </a>
        <p class="reference-note">
          Published by Wiley. My reference for measurements, children's bodice
          blocks, and grading between sizes.
        </p>
      </li>
      <li class="reference">
        <a
          class="reference-link"
          href="https://tmbtradepublishing.com/product/readers-digest-complete-guide-to-sewing"
        >
          The Editors of Reader's Digest, Complete Guide to Sewing
          <svg
            class="reference-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M3.5 5.5c3-1 5.8-.5 8.5 1.5v12c-2.7-2-5.5-2.5-8.5-1.5z" />
            <path d="M12 7c2-1.5 4-2.1 6.2-1.8M12 19c2-1.5 4-2.1 6.2-1.8" />
            <path d="M16.5 8.5h4v4M20.5 8.5l-5 5" />
          </svg>
        </a>
        <p class="reference-note">
          Published by Trusted Media Brands. My reference for construction
          sequence, seam and edge finishes, and working from a garment that
          already fits.
        </p>
      </li>
    </ul>
  </section>

  <img
    class="band-image"
    src="/images/stock/sewing-machine-action.jpg"
    alt="Hands guiding patterned fabric through a sewing machine"
    width="1600"
    height="1067"
    loading="lazy"
  />

  <section class="catalog" aria-labelledby="foundations-heading">
    <h2 class="section-title" id="foundations-heading">Foundations</h2>
    <p class="section-sub">
      Method before garments: numbers you can trust, a block that fits, and how
      to use it.
    </p>
    <div class="card-grid">
      {nav.foundations.map((link, index) => (
        <CatalogCard
          href={link.href}
          title={link.title}
          status={link.status}
          hint={`Step ${String(index + 1).padStart(2, '0')}`}
          text={foundationCopy[link.id]}
          image={firstImage(foundations, link.id) ?? foundationFallbacks[link.id]}
        />
      ))}
    </div>
  </section>

  <section class="catalog" aria-labelledby="items-heading">
    <h2 class="section-title" id="items-heading">Items</h2>
    <p class="section-sub">
      One garment at a time, from measurements through to a finished seam.
    </p>
    {nav.items.map((item) => {
      const entry = items.find((candidate) => candidate.id === item.slug);
      const photo = entry?.data.images[0];
      return (
        <article class="feature">
          <div class="feature-media">
            {photo ? (
              <img src={photo.src} alt={photo.alt} loading="lazy" />
            ) : (
              <img
                src="/images/stock/sewing-orange-fabric.jpg"
                alt="Placeholder: orange fabric under a sewing-machine presser foot"
                width="1600"
                height="2400"
                loading="lazy"
              />
            )}
          </div>
          <div class="feature-body">
            <h3 class="feature-title">{item.title}</h3>
            {entry && (
              <p class="feature-meta">
                <span class={`status status-${entry.data.status}`}>
                  {entry.data.status}
                </span>
              </p>
            )}
            {itemCopy[item.slug] && (
              <p class="feature-text">{itemCopy[item.slug]}</p>
            )}
            {item.branches.length > 0 && (
              <div class="feature-list">
                <p class="feature-list-label">Two pattern branches</p>
                <ul>
                  {item.branches.map((link) => (
                    <li><a href={link.href}>{link.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {item.shared.length > 0 && (
              <div class="feature-list">
                <p class="feature-list-label">Shared construction</p>
                <ul>
                  {item.shared.map((link) => (
                    <li><a href={link.href}>{link.title}</a></li>
                  ))}
                </ul>
              </div>
            )}
            {item.href && (
              <p class="feature-actions">
                <a class="button" href={item.href}>Open {item.title}</a>
              </p>
            )}
          </div>
        </article>
      );
    })}
  </section>

  <p class="landing-credit">
    The photographs on this page are temporary Pexels placeholders, not pictures
    of finished garments from this project:
    <a href="https://www.pexels.com/photo/a-sewing-machine-and-some-fabric-on-a-table-27949560/">Olga Volkovitskaia</a>,
    <a href="https://www.pexels.com/photo/close-up-of-a-sewing-machine-in-action-29226693/">Sergei Starostin</a>,
    and
    <a href="https://www.pexels.com/photo/orange-fabric-in-sewing-machine-9850085/">Ron Lach</a>.
  </p>
</BaseLayout>
